{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "useIgnoreFile": true,
    "clientKind": "git",
  },
  "assist": {
    "enabled": true,
    "actions": {
      "preset": "recommended",
      "source": {
        "preset": "recommended",
        "organizeImports": "on",
        "useSortedAttributes": "on",
      },
    },
  },
  "formatter": {
    "enabled": true,
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe",
        },
      },
    },
  },
  "html": {
    "formatter": {
      "enabled": true,
    },
  },
  "javascript": {
    "assist": {
      "enabled": true,
    },
    "formatter": {
      "enabled": true,
    },
    "linter": {
      "enabled": true,
    },
  },
  "css": {
    "assist": {
      "enabled": true,
    },
    "formatter": {
      "enabled": true,
    },
    "linter": {
      "enabled": true,
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true,
    },
  },
  "tailwind": {
    "mergeFunctions": ["clsx", "cn"],
    "variantFunctions": ["cva"],
  },
}
